<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/background_image_scrim_96pc_bg_color"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/background_image_scrim_96pc_bg_color"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="180"
                android:centerX="0.52"
                android:startColor="@android:color/transparent"
                android:centerColor="?android:attr/colorBackground"
                android:endColor="?android:attr/colorBackground" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="180"
                android:centerX="0.62"
                android:startColor="@android:color/transparent"
                android:centerColor="@color/background_image_scrim_70pc_bg_color"
                android:endColor="@color/background_image_scrim_70pc_bg_color" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/background_image_scrim_30pc_bg_color"/>
        </shape>
    </item>
</layer-list>
